# Perplexity OpenCode Proxy Configuration

# Server port
PORT=8080

# Perplexity session token (auto-extracted if not set)
# PERPLEXITY_SESSION_TOKEN=your_session_token_here

# Perplexity user ID (auto-extracted if not set)
# PERPLEXITY_USER_ID=your_user_id_here

# Debug mode
DEBUG=false

# Cookie database path (auto-detected if not set)
# PERPLEXITY_COOKIE_DB_PATH=C:\Users\%USERNAME%\AppData\Roaming\Perplexity\Cookies
